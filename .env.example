# ═════════════════════════════════════════════════════════════════════════
# 🇮🇳 BHARAT OS — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your Binance API credentials
# ═════════════════════════════════════════════════════════════════════════

# Binance Official Spot Trading Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Active Trading Parameters
TRADING_SYMBOL=WIFUSDT
TAKE_PROFIT_PCT=0.015
STOP_LOSS_PCT=0.008
REAL_MONEY_MODE=true

# IPC & Hardware Telemetry
IPC_PORT=8766
REALTIME_PRIORITY=true
