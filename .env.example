# ═════════════════════════════════════════════════════════════════════════
# 🇮🇳 BHARAT OS — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your Binance API credentials
# ═════════════════════════════════════════════════════════════════════════

# Binance Official API Credentials (Spot & USD-M Futures)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here


# Optional: Cloud Node Sync Configuration (for local terminal bridge)
GCP_SSH_KEY=~/.ssh/id_gcp_deploy
GCP_REMOTE_HOST=username@your_server_ip
GCP_REMOTE_DIR=/home/username/bharatos